{
  "name": "echarts-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "通过 HTTP、MCP 和可选 LLM 生成 SVG/PNG 图表的单容器服务",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "npm run build && node --env-file-if-exists=.env.local dist/main.js",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.mjs",
    "smoke:live": "npm run build && node --env-file-if-exists=.env.local scripts/smoke-live.mjs"
  },
  "dependencies": {
    "@a2a-js/sdk-v0_3": "npm:@a2a-js/sdk@0.3.14",
    "@ai-sdk/openai-compatible": "3.0.49",
    "@mastra/core": "1.67.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "echarts": "6.1.0",
    "fast-xml-parser": "5.11.1",
    "fastify": "5.12.4",
    "sharp": "0.35.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "typescript": "7.0.2"
  }
}
