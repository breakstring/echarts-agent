# HTTP/MCP/A2A 统一鉴权：有 SERVICE_API_KEY 时都要求 Bearer，即使启用匿名。
# 无 key 时必须显式 ALLOW_ANONYMOUS=true，否则拒绝启动。
ALLOW_ANONYMOUS=true
# SERVICE_API_KEY=
PORT=3000
RENDER_WORKERS=2
RENDER_QUEUE_LIMIT=8
RENDER_TIMEOUT_MS=10000
# 未提供 key 时默认禁用；设 false 可强制关闭。
# LLM_ENABLED=true
# LLM_PROVIDER=dashscope
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen3.8-flash
# LLM_API_KEY=
LLM_TIMEOUT_MS=60000
# JSON Object + 本地 Schema 校验；思考固定关闭。诊断日志只含元数据，不含正文。
LLM_LOG_LEVEL=info

# A2A 默认关闭；启用时需要真实访问 origin，鉴权沿用上述全局模式。
A2A_ENABLED=false
# A2A_PUBLIC_URL=http://127.0.0.1:3000
