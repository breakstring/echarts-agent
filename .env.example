# 本地开发可显式启用匿名；部署时设置随机 SERVICE_API_KEY 并关闭匿名。
ALLOW_ANONYMOUS=true
# SERVICE_API_KEY=
PORT=3000
RENDER_WORKERS=2
RENDER_QUEUE_LIMIT=8
RENDER_TIMEOUT_MS=10000
# 未提供 key 时默认禁用；设 false 可强制关闭。
# LLM_ENABLED=true
# LLM_PROVIDER=dashscope
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen3.8-flash
# LLM_API_KEY=
LLM_TIMEOUT_MS=60000

# A2A 默认关闭；启用时需要 SERVICE_API_KEY 和真实访问 origin。
A2A_ENABLED=false
# A2A_PUBLIC_URL=http://127.0.0.1:3000
